# Copy to .env and adjust. scripts/install.sh generates this file for you.
# Never commit .env.

# ------------------------------------------------------------------ storage
POSTGRES_USER=pqa
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=pqa
# DATABASE_URL / REDIS_URL are composed in docker-compose.yml; set them only
# when running outside Docker:
# DATABASE_URL=postgresql+asyncpg://pqa:secret@localhost:5432/pqa
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------ ProxyScrape-style validation
# The default HTTP judge matches the open-source ProxyScrape checker. Its
# response is used to determine exit IP plus elite/anonymous/transparent.
PROBE_HTTP_URL=http://judge1.api.proxyscrape.com
PROBE_OWNED=false
# HTTPS capability is still checked separately with certificate verification.
PROBE_HTTPS_URL=https://api.ipify.org/?format=json
# Public IP of this VPS. Leave empty to auto-detect; ProxyScrape's IP endpoint
# is tried first, followed by fallback IP echo services.
ORIGIN_IP=

# ------------------------------------------------------------------ scheduling
REFRESH_INTERVAL_SECONDS=120
POOL_SYNC_INTERVAL_SECONDS=20

# ------------------------------------------------------------------ validator capacity
# Starting points only; adaptive concurrency adjusts within [min, these max values].
FAST_VALIDATION_CONCURRENCY=300
DEEP_VALIDATION_CONCURRENCY=100
ADAPTIVE_CONCURRENCY=true

# ------------------------------------------------------------------ sources
# ProxyScrape is the only configured public source in config/sources.yaml.
STRICT_SOURCE_LICENSING=true

# ------------------------------------------------------------------ API
API_WORKERS=2
API_DEFAULT_LIMIT=100
API_MAX_LIMIT=5000
API_DEFAULT_MAX_AGE_SECONDS=900
API_CORS_ORIGINS=*
HTTP_PORT=80

# ------------------------------------------------------------------ logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------ container memory limits
WORKER_MEM_LIMIT=768m
API_MEM_LIMIT=384m
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
REDIS_MAXMEMORY=192mb

# ------------------------------------------------------------------ optional: publish snapshots to a git branch
GIT_PUBLISH_ENABLED=false
# https URL of the repository (token is sent as an HTTP header, never stored in the URL)
GIT_PUBLISH_REPO=https://github.com/OWNER/REPO.git
GIT_PUBLISH_BRANCH=proxy-data
# fine-grained token with "Contents: read and write" on that repository only
GIT_PUBLISH_TOKEN=
# >= 300; default 1800 (every 30 minutes)
GIT_PUBLISH_INTERVAL_SECONDS=1800
# squash = one force-pushed commit (repository does not grow); append = keep history
GIT_PUBLISH_MODE=squash
